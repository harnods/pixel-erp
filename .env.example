# Gemini API key for the Cowork feature (server-side only)
NUXT_GEMINI_API_KEY=your-key-here

# ── Access gate: Google @mekari.com login ─────────────────────────────────────
# Google OAuth Web Client ID (public). In Google Cloud Console → Credentials,
# create an OAuth 2.0 Client ID (Web application) and add these to
# "Authorised JavaScript origins": http://localhost:4321, http://localhost:4322,
# and your Vercel URL. Empty = gate disabled (app open).
NUXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# HMAC secret that signs the session cookie (server-only). Any long random string;
# generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotate this value to invalidate every existing session (logs everyone out).
NUXT_SESSION_SECRET=change-me-to-a-long-random-string

# Only this Google Workspace domain may sign in.
NUXT_ALLOWED_EMAIL_DOMAIN=mekari.com
